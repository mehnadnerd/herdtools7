(*****************************************)
(* The RISCV Instruction set manual v2.3 *)
(*****************************************)

let anyR = R
let anyW = W
let anyM = M
let R = anyR & Exp
let W = anyW & Exp
let M = anyM & Exp
let I = anyR & NExp (* TODO does this include PTE reads? *)

(*************)
(* Utilities *)
(*************)

let fence.r.r = [R];fencerel(Fence.r.r);[R]
let fence.r.w = [R];fencerel(Fence.r.w);[W]
let fence.r.rw = [R];fencerel(Fence.r.rw);[M]
let fence.w.r = [W];fencerel(Fence.w.r);[R]
let fence.w.w = [W];fencerel(Fence.w.w);[W]
let fence.w.rw = [W];fencerel(Fence.w.rw);[M]
let fence.rw.r = [M];fencerel(Fence.rw.r);[R]
let fence.rw.w = [M];fencerel(Fence.rw.w);[W]
let fence.rw.rw = [M];fencerel(Fence.rw.rw);[M]
let fence.tso =
  let f = fencerel(Fence.tso) in
  ([W];f;[W]) | ([R];f;[M])
let fence.i = [M];fencerel(Fence.i);[M] (* Added because of combination of ir4->ir3->ir1, allows using fence.i as a fence without using -variant self *)

let fence =
  fence.r.r | fence.r.w | fence.r.rw |
  fence.w.r | fence.w.w | fence.w.rw |
  fence.rw.r | fence.rw.w | fence.rw.rw |
  fence.tso | fence.i

let po-loc-no-w = po-loc \ (po-loc?;[W];po-loc)
let rsw = rf^-1;rf
(* These don't include AcqRel because read and write events are seperated so it doesn't exist *)
let AQ = (Acq)
and RL = (Rel)
let AMO = try AMO with (R & W) (* Compat *)
let RCsc = (Acq|Rel) & (AMO|X)
(*************)
(* ppo rules *)
(*************)

(* Overlapping-Address Orderings *)
let r1 = [M];po-loc;[W]
and r2 = ([R];po-loc-no-w;[R]) \ rsw
and r3 = [AMO|X];rfi;[R]
(* Explicit Synchronization *)
and r4 = fence
and r5 = [AQ];po;[M]
and r6 = [M];po;[RL]
and r7 = [RCsc];po;[RCsc]
and r8 = rmw
(* Syntactic Dependencies *)
and r9 = [M];addr;[M]
and r10 = [M];data;[W]
and r11 = [M];ctrl;[W]
(* Pipeline Dependencies *)
and r12 = [M];(addr|data);[W];rfi;[R]
and r13 = [M];addr;[M];po;[W]

let ppo =
  r1
| r2
| r3
| r4
| r5
| r6
| r7
| r8
| r9
| r10
| r11
| r12
| r13

(**************)
(* ippo rules *)
(**************)

if variant "self" 
(*let ir1 = [I];po;[M]*) (* I think this is OK for coherent I$ *)
let ir1 = [I];(iico_data|iico_ctrl|rf-reg)+
and ir2 = [I];po;[I] (* Hypothesis is that removing this is sufficient to handle incoherent I$ *)
and ir3 = [M];fencerel(Fence.i);[I]

let ippo = 0
| ir1
| ir2
| ir3

let irf = [W];rf;[I]

else
let ippo = 0
let irf = 0
end