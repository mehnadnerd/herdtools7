RISCV IDC.MP.RF+fencei
Variant=self
CacheType=IDC
{ 0:t0=instr:"li s0, 1"; 0:a2=P1:mod; 0:a1=x; 0:t1=1;
                                      1:a1=x; }
P0           | P1           ;
sw t0,0(a2)  |  lw s1,(a1)  ;
fence w,w    |  fence.i     ;
sw t1,0(a1)  | mod:         ;
             |  nop  ;
~exists (1:s0=0 /\ 1:s1=1)
(* Message passing with load->fence.i->fetch  *)
