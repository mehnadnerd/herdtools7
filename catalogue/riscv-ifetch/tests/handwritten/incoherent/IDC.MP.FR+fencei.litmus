RISCV IDC.MP.FR+fencei
Variant=self
CacheType=IDC
{ 0:t0=instr:"nop"; 0:a1=P1:mod; 0:a2=x; 0:t1=1;
                                 1:a2=x; }
P0           | P1           ;
sw t1,0(a2)  | mod:         ;
fence w,w    |  li s0, 1    ;
sw t0,0(a1)  |  fence.i     ;
             |  lw s1,(a2)  ;
~exists (1:s0=0 /\ 1:s1=1)
(* Message passing with fetch->fence.i=>load, TODO needs non-mod fetch *)
