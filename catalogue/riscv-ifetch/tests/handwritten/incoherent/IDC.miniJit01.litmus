RISCV IDC.miniJit01
Variant=self
CacheType=IDC
{ 
[x] = P1:L0;
0:a0=P0:L1; 0:a1=x; 0:t2=instr:"li s0, 3";
1:a1=x; 1:s0=0;}
P0           | P1           ;
sw t2,0(a0)  |  ld s1,(a1)  ;
fence w,w    |  jr s1       ;
sd a0,0(a1)  | L0:          ;
             |  li s0, 1    ;
             |  j L3        ;
             | L1:          ;
             |  li s0, 2    ;
             | L3:          ;
exists (1:s0=2)
(* Coherence needed so that we will eventually see the instruction update *)
(* Just because we do the address update after the instruction update doesn't mean we are guaranteed to see new *)
(* Based on miniJit01 *)
