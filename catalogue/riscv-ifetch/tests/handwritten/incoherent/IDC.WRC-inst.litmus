RISCV IDC.WRC-inst
Variant=self
CacheType=IDC
{ 0:t0=instr:"li s0, 1"; 0:a1=P0:mod; 
  1:t0=instr:"li s0, 1"; 1:a1=P0:mod;
  1:a2=x;2:a2=x; 1:t1=1; 2:a1=P0:mod; }
P0           | P1          | P2          ;
 sw t0,0(a1) |  jalr a1    |  lw s2,(a2) ;
 j end       |  sw t1,(a2) |  fence.i    ;
mod:         |             |  jalr a1    ;
 nop         |             |             ;
 jr ra       |             |             ; 
end:         |             |             ;
exists(1:s0=1 /\ 2:s2=1 /\ 2:s0=0)
