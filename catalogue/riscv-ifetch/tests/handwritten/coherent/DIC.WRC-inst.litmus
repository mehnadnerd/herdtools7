RISCV DIC.SB+fencei
Variant=self
CacheType=DIC
{ 0:t0=instr:"li s0, 1"; 0:a1=P1:mod1; 
  1:t0=instr:"li s0, 1"; 1:a1=P0:mod0; }
P0           | P1           ;
 sw t0,0(a1) |  sw t0,(a1)  ;
mod0:        | mod1:        ;
 nop         |  nop         ;
exists (0:s0=0 /\ 1:s0=0)
(* TODO needs jr to work *)

AArch64 DIC1.WRC-inst
Stable=X9
CacheType=DIC
{ 0:X0=NOP;
  0:X1=P0:mod; 1:X1=P0:mod; 2:X1=P0:mod;
  1:X3=x; 2:X3=x; }
 P0          | P1          |  P2          ;
 STR W0,[X1] | BLR X1      |  LDR W2,[X3] ;
 B end       | MOV W2,#1   |  CBNZ W2,l2  ;
mod:         | STR W2,[X3] | l2:          ;
 B l0        |             |  ISB         ;
 MOV W9,#1   |             |  BLR X1      ;
l0:          |             |              ;
 RET         |             |              ;
end:         |             |              ;
exists(1:X9=1 /\ 2:X2=1 /\ 2:X9=0)


