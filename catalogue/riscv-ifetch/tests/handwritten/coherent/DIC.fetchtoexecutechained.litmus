RISCV DIC.fetchtoexecutechained
Variant=self
CacheType=DIC
{ 
  int x=2;
  0:t0=instr:"mv a3, t1"; 0:a1=P1:mod; 1:a1=P1:mod;
  0:t2=1;                    0:a3=z; 1:a3=z; 1:s9=0; 1:t0=x; 1:t1=z;}
P0           | P1           ;
sw t2,0(a3)  |              ;
fence w,w    |              ;
sw t0,0(a1)  | mod:         ;
             |  mv a3, t0   ;
             |  lw s9, 0(a3);
~exists 1:s9=0
(* This test works coherently because teh fetch of mod needs to be before the fetch of lw and hence the load *)
