RISCV DIC.S.RF+fencei
Variant=self
CacheType=DIC
{ 0:t0=instr:"li s0, 1"; 0:a1=P0:mod;
                         1:a1=P0:mod; }
P0           | P1           ;
 sw t0,0(a1) |  lwu s1,(a1) ;
 j end       |  fence.i     ;
mod:         |  jr a1       ;
 nop         |              ;
end:         |              ;
~exists (1:s0=0 /\ 1:s1=instr:"li s0, 1")
(* If we see new instruciton on data side, should see on instruction side after fence.i, even on other core  *)

