RISCV DIC.emailQ4
Variant=self
CacheType=DIC
{ 
0:a0=P0:mod; 0:t0=instr:"sw t1,0(a1)";
1:a0=P0:mod; 0:t1=1; 1:t1=1;
0:a1=y;1:a1=y;
}
P0           | P1           ;
 sw t0,0(a0) | lw s1,0(a1)  ;
mod:         |              ;
 nop         | fence rw,rw  ;
 lw s0,0(a1) | lwu s0,0(a0) ;

~exists (1:s0=instr:"nop" /\ 1:s1=1 /\ y=1)
(* We are checking whether or not P0's first store *)
(* is before its second store *)
(* y=1 ensures we did fetch the store *)
