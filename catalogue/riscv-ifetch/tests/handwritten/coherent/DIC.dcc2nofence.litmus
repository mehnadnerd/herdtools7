RISCV DIC.dcc2nofence
Variant=self
CacheType=DIC
{ 0:t0=nop;       0:a1=P1:mod; 1:a1=P1:mod;
  0:t2=1;         0:a3=z; 1:a3=z; 1:s9=0; }
P0           | P1           ;
sw t0,0(a1)  |  lw s0,0(a3) ;
fence w,w    |              ;
sw t2,0(a3)  | mod:         ;
             |  j end       ;
             |  li s9, 1    ;
             | end:         ;  

exists 1:s0=1 /\ 1:s9=0
(* Without fence.i any ordering is allowed *)