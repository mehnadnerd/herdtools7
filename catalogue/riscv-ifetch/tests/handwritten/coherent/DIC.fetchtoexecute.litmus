RISCV DIC.fetchtoexecute
Variant=self
CacheType=DIC
{ 0:t0=instr:"lw s9, 0(a3)"; 0:a1=P1:mod; 1:a1=P1:mod;
  0:t2=1;                    0:a3=z; 1:a3=z; 1:s9=0; }
P0           | P1           ;
sw t2,0(a3)  |              ;
fence w,w    |              ;
sw t0,0(a1)  | mod:         ;
             |  li s9, 2    ;
~exists 1:s9=0
(* Test for fetch of an instruction being before its execution *)
(* We should either do the li and move 2, or do the lw in which case we must have seen the store of 1 *)
