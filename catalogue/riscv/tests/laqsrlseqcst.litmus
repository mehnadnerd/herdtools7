RISCV lw.aq sw.rl
{
0:x1=x; 0:x2=y; 0:x3=1; 0:x4=1;
1:x1=x; 1:x2=y; 1:x3=1; 1:x4=1;
x=0; y=0;
}
P0                 | P1              ;
                   | sw    x3, 0(x1) ;
addi x4, x0, 1     | fence rw, rw    ;
sw.rl x4, 0(x2)    | lw    x4, 0(x2) ;
lw.aq x3, 0(x1)    |                 ;
exists (0:x3=0 /\ 1:x4=0)
